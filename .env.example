# Porta HTTP da API
PORT=3000
# Caminho do arquivo SQLite (use :memory: para banco em memória)
DATABASE_PATH=./data/wallet.db
# URL do webhook do serviço anti-fraude (gateway externo fictício)
ANTIFRAUD_WEBHOOK_URL=http://localhost:4000/webhooks/antifraud
# Timeout (ms) da chamada ao webhook anti-fraude
ANTIFRAUD_TIMEOUT_MS=2000
